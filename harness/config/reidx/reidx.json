      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "servers": {
      "memory": {
        "codemode": false,
        "type": "local",
        "command": [
          "python3",
          "memory-mcp/server.py"
        ],
        "environment": {
          "LITELLM_API_BASE": "{env:REIDX_SAFE_LLM_URL}",
          "LITELLM_API_KEY": "{env:LITELLM_MASTER_KEY}",
          "EMBEDDING_MODEL": "nomic-embed"
        },
        "disabled": false,
        "timeout": {
          "catalog": 180000,
          "execution": 180000
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "litellm",
      "effect": "allow"
    }
  ]
}
